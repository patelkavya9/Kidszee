<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF5F0">

    <TextView
        android:id="@+id/titleTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginStart="32dp"
        android:layout_marginTop="32dp"
        android:text="Shapes"
        android:textColor="#333333"
        android:textSize="36sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/instructionsTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/titleTextView"
        android:layout_marginStart="32dp"
        android:layout_marginTop="8dp"
        android:text="Place the corresponding shapes in shaded area"
        android:textColor="@color/black"
        android:textSize="16sp" />

    <!-- Left side - target areas -->
    <LinearLayout
        android:id="@+id/targetAreasContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/instructionsTextView"
        android:layout_marginStart="32dp"
        android:layout_marginTop="32dp"
        android:orientation="vertical">

        <!-- Square target -->
        <FrameLayout
            android:id="@+id/squareTarget"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_margin="12dp"
            android:background="@drawable/shape_square_target"
            />

        <!-- Triangle target -->
        <FrameLayout
            android:id="@+id/triangleTarget"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_margin="12dp"
            android:background="@drawable/shape_triangle_target" />

        <!-- Hexagon target -->
        <FrameLayout
            android:id="@+id/hexagonTarget"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_margin="12dp"
            android:background="@drawable/shape_rectangle_target" />

        <!-- Circle target -->
        <FrameLayout
            android:id="@+id/circleTarget"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_margin="12dp"
            android:background="@drawable/shape_circle_target" />
    </LinearLayout>

    <!-- Right side - draggable shapes -->
    <LinearLayout
        android:id="@+id/shapesContainer"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_alignParentEnd="true"
        android:layout_below="@id/instructionsTextView"
        android:layout_marginEnd="32dp"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- Triangle -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/triangleShape"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/tri"
                android:tag="triangle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Triangle"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Triángulo"
                android:textColor="#999999"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Hexagon -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/hexagonShape"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/sq"
                android:tag="hexagon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Square"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hexágono"
                android:textColor="#999999"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Circle -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/circleShape"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/circle"
                android:tag="circle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Circle"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Círculo"
                android:textColor="#999999"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Rectangle -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/rectangleShape"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/rectangle"
                android:tag="rectangle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Rectangle"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rectángulo"
                android:textColor="#999999"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/imageView10"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_alignTop="@+id/titleTextView"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="-10dp"
        android:layout_marginEnd="25dp"
        android:foregroundGravity="bottom"
        app:srcCompat="@drawable/logo" />
</RelativeLayout>